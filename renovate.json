{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":gitSignOff",
    ":semanticCommitType(chore)",
    ":labels(automated,no-issue)",
    "customManagers:githubActionsVersions",
    ":automergeMinor",
    ":automergeDigest"
  ],
  "enabled": true,
  "enabledManagers": [
    "github-actions",
    "custom.regex"
  ],
  "prConcurrentLimit": 5,
  "ignorePaths": [],
  "semanticCommits": "enabled",
  "commitBodyTable": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update versions annotated with '# renovate:' comments in the Taskfiles",
      "managerFilePatterns": [
        "/^taskfiles/taskfile\\.[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: registryUrl=(?<registryUrl>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: currentValue=(?<currentValue>[^\\s]+?))?\\s+[A-Za-z0-9_]+?_SHA\\s*:\\s*[\"']?(?<currentDigest>[a-f0-9]+?)[\"']?\\s",
        "# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: registryUrl=(?<registryUrl>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s+[^:=]+\\s*[:=]\\s*[\"']?(?<currentValue>[^@]+?)(@(?<currentDigest>.+))?[\"']?\\s"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Group all github-tags updates into a single PR",
      "matchDatasources": [
        "github-tags"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest",
        "major",
        "minor",
        "patch"
      ],
      "groupName": "all github tags",
      "pinDigests": true
    },
    {
      "description": "Avoid pinning digests for github-tags dependencies tracked via '# renovate:' annotations, as they are plain versions with no digest to update",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "github-tags"
      ],
      "pinDigests": false
    },
    {
      "description": "Skip alpha releases of container images",
      "matchDatasources": [
        "docker"
      ],
      "allowedVersions": "!/alpha/"
    }
  ]
}
